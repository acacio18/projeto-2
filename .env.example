# Modelo de configuração local. Copie para .env (que NÃO vai para o repositório) e preencha.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Senha do usuário suap_v2: %USERPROFILE%\.suap_v2\suap_v2_db_password.txt
DATABASE_URL=postgres://suap_v2:SENHA@localhost:5432/suap_v2
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Contas e login (opcionais; os valores abaixo são os padrões) ---
# Domínios de e-mail aceitos no cadastro, separados por vírgula (confirmados em 11/11/2026).
# CONTAS_DOMINIOS_EMAIL=ifpb.edu.br,academico.ifpb.edu.br
# Minutos sem uso até a sessão expirar.
# CONTAS_SESSAO_INATIVIDADE_MINUTOS=30
# Falhas seguidas que bloqueiam a conta, e por quantos minutos.
# CONTAS_LOGIN_FALHAS_PARA_BLOQUEIO=5
# CONTAS_LOGIN_BLOQUEIO_MINUTOS=30
# Validade, em horas, do link de convite e de redefinição de senha.
# CONTAS_LINK_SENHA_VALIDADE_HORAS=72
# E-mail: sem estas linhas, as mensagens só aparecem no terminal. Para enviar de verdade por uma
# conta Google (Gmail ou @academico.ifpb.edu.br), crie uma "senha de app" na conta e grave-a em
# %USERPROFILE%\.suap_v2\smtp_senha_de_app.txt (nunca neste arquivo).
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_HOST_USER=conta@academico.ifpb.edu.br
# DJANGO_EMAIL_SENHA_ARQUIVO=C:\Users\<usuário>\.suap_v2\smtp_senha_de_app.txt
# DJANGO_DEFAULT_FROM_EMAIL=SUAP V2 <conta@academico.ifpb.edu.br>
# Endereço do site nos links dos e-mails, para abrir em outro computador (vazio: o de quem acessou).
# DJANGO_ENDERECO_PUBLICO=http://192.168.0.10:8000
